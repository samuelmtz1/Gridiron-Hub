# ==============================================================================
# Gridiron Hub - Environment Configuration Template
# NUNCA subas el archivo .env real con credenciales a Git.
# ==============================================================================

# Entorno de ejecución: 'development', 'mock' (Staging Mock Preview), 'production'
APP_ENV=development

# Base de datos local (SQLite o DuckDB)
DATABASE_URL=sqlite:///storage/gridiron.db

# Cache para nflreadpy (evita descargas repetidas de nflverse)
NFLREADPY_CACHE=filesystem

# CollegeFootballData.com API Key (Gratis hasta 1,000 req/mes)
# Obtén tu token gratis en: https://collegefootballdata.com/key
CFBD_API_KEY=your_cfbd_bearer_token_here

# API-Football / API-NFL (Fallback terciario gratuito de 100 req/día)
API_FOOTBALL_KEY=your_api_football_key_here

# TheSportsDB API Key (Usar 123 para desarrollo y pruebas públicas)
THESPORTSDB_KEY=123

# Token compartido para proteger el API interna en FastAPI (X-Team-Token)
TEAM_SHARED_SECRET=your_secure_team_token_here

# Puerto para el API de FastAPI
PORT=8000
