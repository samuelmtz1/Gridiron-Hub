# Gridiron Hub 2.0 — Variables de Entorno de Plantilla
# ADVERTENCIA: NUNCA guardes secretos reales ni credenciales en este archivo.
# Copia este archivo a .env.local para desarrollo local (ignorado en .gitignore).

# Entorno de ejecución: development | staging | production
APP_ENV=development
LOG_LEVEL=INFO

# Criptografía de Sesiones de Equipo (32 bytes hex generados de forma segura)
# En producción, genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
TEAM_SHARED_SECRET=genera_un_token_criptografico_seguro_de_32_bytes_aqui

# Puerto de la API FastAPI
PORT=8000
HOST=127.0.0.1

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://localhost:5173

# Base de datos SQLite v2 (por defecto local en v2/storage/)
DATABASE_PATH=v2/storage/gridiron_v2.db

# Configuración de usuarios para producción (JSON con usernames y hashes PBKDF2)
# Genera los hashes con: python3 v2/security/manage_users.py hash-password <tu_contraseña>
# GRIDIRON_USERS_JSON='[{"username":"sam","password_hash":"salt$hash"},{"username":"editor","password_hash":"salt$hash"}]'

